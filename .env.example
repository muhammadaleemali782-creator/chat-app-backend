# MongoDB Atlas connection string (Atlas dashboard se milega)
MONGO_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/chatapp?retryWrites=true&w=majority

# JWT secret - koi bhi random lamba string daal do
JWT_SECRET=yeh_ek_bahut_lamba_random_secret_string_hona_chahiye_123456

# Server port
PORT=5000

# Frontend URL (CORS ke liye - deploy karte waqt Vercel URL dalna)
FRONTEND_URL=http://localhost:5173

# Email (Resend.com) - password reset OTP bhejne ke liye
# Free account: https://resend.com (credit card ki zarurat nahi)
# Sign up karke Dashboard > API Keys se apni key copy karo
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxx
# Testing ke liye ye default "from" address use kar sakte ho (koi setup nahi chahiye):
RESEND_FROM_EMAIL=ChatApp <onboarding@resend.dev>
